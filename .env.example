RELAY_MODE=capture
GROK_ROUTINE_URL=
GROK_ROUTINE_KEY=
MCP_BEARER=
# Required only with RELAY_MODE=imessage
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
TEST_SENDER=

# Optional. Set to ollama for local LangChain replies without Grok credentials.
RELAY_BACKEND=grok
OLLAMA_MODEL=qwen3.5:9b

# Optional. JSON lines written to this file and to the console.
RELAY_LOG_FILE=relay.log
